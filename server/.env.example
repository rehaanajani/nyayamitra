# Gnani API key from https://app.gnani.ai/voice (Prisma STT + Timbre TTS)
GNANI_API_KEY=

# Any OpenAI-compatible endpoint. For Gnani Evon, serve it with vLLM:
#   vllm serve gnani/gnani-evon-v3.3 --max-model-len 131072 --trust-remote-code \
#     --enable-auto-tool-choice --tool-call-parser qwen3_coder --reasoning-parser nano_v3
# then set LLM_BASE_URL=http://<host>:8000/v1 and LLM_MODEL=gnani/gnani-evon-v3.3
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional voice overrides (Timbre v3.0 voices)
# VOICE_SAHAY=Lakshmi
# VOICE_JUDGE=Prakash
# VOICE_OPPONENT=Devansh
