# ============================================================
#  न्यायमित्र — keys (this file is gitignored, never pushed)
#  Fill the values after the = sign, save, then restart the api.
# ============================================================

# 1) REQUIRED for voice — Gnani API key
#    Get it at https://app.gnani.ai/voice -> API keys (3 free keys).
#    Used for Prisma (listening) and Timbre (speaking).
GNANI_API_KEY=

# 2) Gnani Evon, any OpenAI-compatible server. Free route: run
#    deploy/kaggle-evon.ipynb on Kaggle (2x T4), then deploy/evon-url.sh fills these.
#      LLM_BASE_URL=https://<tunnel>.trycloudflare.com/v1
#      LLM_MODEL=evon
#      LLM_API_KEY=<key the notebook prints>
#    Leave empty to use HF_TOKEN (Evon on a Hugging Face Space) or the rule-based fallback.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# 2b) OPTIONAL backup LLM, used only when Evon is unreachable.
#     Gemini on Vertex AI with an API key from any GCP account (billed to that account):
#       BACKUP_LLM_BASE_URL=https://aiplatform.googleapis.com/v1
#       BACKUP_LLM_MODEL=gemini-2.5-flash
#       BACKUP_LLM_API_KEY=<Vertex AI API key>
#     Or leave the key empty with a .../projects/<p>/locations/global/endpoints/openapi
#     base URL to sign in as the Cloud Run service account instead.
#     Or a free AI Studio key: BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
BACKUP_LLM_BASE_URL=
BACKUP_LLM_MODEL=
# the quickest model, leads for replies someone is waiting to hear
BACKUP_LLM_FAST_MODEL=
BACKUP_LLM_API_KEY=

# 3) OPTIONAL — Timbre v3.0 voices (defaults shown)
VOICE_SAHAY=Lakshmi
VOICE_JUDGE=Prakash
VOICE_OPPONENT=Devansh

# 4) Evon via the Hugging Face Space (free ZeroGPU). Read token from huggingface.co/settings/tokens
HF_TOKEN=
