# ============================================================
#  न्यायमित्र — keys (this file is gitignored, never pushed)
#  Fill the values after the = sign, save, then restart the api.
# ============================================================

# 1) REQUIRED for voice — Gnani API key
#    Get it at https://app.gnani.ai/voice -> API keys (3 free keys).
#    Used for Prisma (listening) and Timbre (speaking).
GNANI_API_KEY=

# 2) REQUIRED for smart conversation — any OpenAI-compatible LLM
#    Best: Gnani Evon on your own GPU (vLLM), e.g.
#      LLM_BASE_URL=http://<gpu-host>:8000/v1
#      LLM_MODEL=evon   (vllm serve gnani/gnani-evon-v3.3-30B-A3B --served-model-name evon)
#      LLM_API_KEY=            (leave empty if your vLLM has no auth)
#    Until Evon is hosted, any OpenAI-compatible provider works, e.g. Groq:
#      LLM_BASE_URL=https://api.groq.com/openai/v1
#      LLM_MODEL=llama-3.3-70b-versatile
#      LLM_API_KEY=gsk_...
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# 3) OPTIONAL — Timbre v3.0 voices (defaults shown)
VOICE_SAHAY=Lakshmi
VOICE_JUDGE=Prakash
VOICE_OPPONENT=Devansh
